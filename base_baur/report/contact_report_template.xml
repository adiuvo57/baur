    <record id="action_report_contact" model="ir.actions.report">
        <field name="name">Laufblatt</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_baur.main_contact_report_template</field>
        <field name="report_file">base_baur.main_contact_report_template</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
