<odoo>
    <template id="contact_report_template">
        <div class="page">
            <div class="row">
              <div class="col-4">
                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y')"/>
              </div>
              <div class="col-4">
                <span t-field="doc.x_studio_herkunft"></span>
              </div>
              <div class="col-4">
                <span>PLZ:</span>
                <span t-field="doc.zip"></span>
              </div>
            </div>
        </div>
    </template>
