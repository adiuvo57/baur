<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form_size_pricing" model="ir.ui.view">
        <field name="name">product.template.form.size.pricing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="base_baur.base_baur_product_template_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='grosse']" position="after">
                <field name="show_in_size_pricing_popup"/>
            </xpath>
        </field>
    </record>
</odoo>
